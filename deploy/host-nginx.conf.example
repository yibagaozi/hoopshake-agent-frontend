# ─────────────────────────────────────────────────────────────────────────
# 宿主机 nginx → 前端容器（127.0.0.1:8082）
#
# 容器内部已经做完全部路由：/student/ /teacher/ 的 SPA 回退、静态缓存、
# /api 反代到 backend:8080。所以宿主机这层只需把请求整体转进去，
# 不要在这里再拆路径，否则两层规则容易打架。
#
# 用法二选一：
#   A. 前端有独立域名 → 直接用下面整个 server 块
#   B. 与现有站点共用域名 → 只把 ↓「location 部分」拷进你现有的 server 块
# ─────────────────────────────────────────────────────────────────────────

server {
    # nginx < 1.25.1 用这种写法开 http2；1.25.1+ 才有独立的 http2 on;
    listen 443 ssl http2;

    server_name  你的域名.com;          # ← 改成实际域名

    ssl_certificate      你的域名.com_bundle.crt;
    ssl_certificate_key  你的域名.com.key;

    ssl_session_cache    shared:SSL:1m;
    ssl_session_timeout  5m;
    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_ciphers          ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE;
    ssl_prefer_server_ciphers on;

    # 知识库导入的 Markdown 可能较大
    client_max_body_size 20m;

    # ══════════════ location 部分（方式 B 拷这一段）══════════════

    # ── AI 对话 / 课堂实况是 SSE 长连接，必须单独放行 ──────────────
    location /api/ {
        proxy_pass http://127.0.0.1:8082;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # 这三行是 SSE 的命门：少了会「憋住不出字」，
        # 用户看到的现象是 AI 回复要等很久然后一次性全部出现
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;      # 心跳 15s/次，默认 60s 会掐断连接
        proxy_send_timeout 3600s;

        # 绝不能压缩 text/event-stream，压缩会引入缓冲
        gzip off;
    }

    # ── 其余请求（页面与静态资源）──────────────────────────────────
    location / {
        proxy_pass http://127.0.0.1:8082;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
    }

    # ══════════════ location 部分到此 ══════════════
}

# HTTP 跳 HTTPS。若你现有配置已有这段就别重复加
server {
    listen 80;
    server_name 你的域名.com;
    rewrite ^(.*)$ https://$host$1 permanent;
}
