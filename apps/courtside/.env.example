# 复制成 .env 后按现场环境改

# 云端地址，用于教师登录与列课。
#
# 【常规部署留空】留空时前端走相对 /api，由本机 nginx 反代到云端（CLOUD_ORIGIN
# 在 compose 里给 nginx），浏览器只跟本服务同源通信 → 云端不必为场边开 CORS，
# 也没有混合内容问题。
# 只有不经 nginx、前端直连云端时才填绝对地址，那时云端必须放行 CORS。
# 页面上没有手填入口：地址只认这里，避免现场两处配置打架。
VITE_CLOUD_BASE_URL=

# 开发时 /api 代理到哪（仅 VITE_CLOUD_BASE_URL 留空时生效）
VITE_CLOUD_PROXY_TARGET=http://127.0.0.1:8080

# edge 服务地址。仅开发 / 预览时用，vite 把 /local 与 /ws 代理到这里。
# 生产由 nginx 反代，见 docker/nginx.conf.template 的 EDGE_ORIGIN。
VITE_EDGE_ORIGIN=http://127.0.0.1:8080

# 开发服务器端口
VITE_PORT=5173
VITE_PREVIEW_PORT=4173

# ---- 联调开关，后端接口齐了就关掉 ----

# 允许不选课直接开「纯录制」。
# 云端 gallery 接口没就绪时 POST /local/lesson/select 会失败（它强依赖名单同步），
# 打开这个就能跳过选课，直接开录测 WS 与录制链路。
VITE_ALLOW_NO_LESSON=true

# 底部导航多一个「调试」页，看 WS 推了哪些事件、payload 长什么样
VITE_SHOW_WS_DEBUG=true

# 骨架帧也记进调试日志。poseFrame 有 15Hz 以上，默认只计数不留原文
VITE_LOG_POSE_FRAMES=false
